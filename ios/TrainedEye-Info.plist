<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Trained Eye</string>
	<!-- The scheme Meta AI calls back on after registration and permission requests. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>trainedeye</string>
			</array>
		</dict>
	</array>
	<!-- Meta Wearables Device Access Toolkit, as in Meta's CameraAccess sample. With
	     Developer Mode, MetaAppID and ClientToken may stay empty or unexpanded. Analytics and
	     crash reporting are on by default in the SDK: both are turned off here. -->
	<key>MWDAT</key>
	<dict>
		<key>AppLinkURLScheme</key>
		<string>trainedeye://</string>
		<key>MetaAppID</key>
		<string>$(META_APP_ID)</string>
		<key>ClientToken</key>
		<string>$(CLIENT_TOKEN)</string>
		<key>TeamID</key>
		<string>$(DEVELOPMENT_TEAM)</string>
		<key>Analytics</key>
		<dict>
			<key>OptOut</key>
			<true/>
		</dict>
		<key>CrashReporting</key>
		<dict>
			<key>OptOut</key>
			<true/>
		</dict>
	</dict>
	<!-- CameraAccess's four modes, plus external-accessory, which the SDK docs and
	     BirdSpotter list for the Bluetooth Classic link that camera streaming uses. audio
	     lets alerts be spoken while the app is in the background. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
		<string>bluetooth-central</string>
		<string>audio</string>
		<string>bluetooth-peripheral</string>
		<string>external-accessory</string>
	</array>
	<key>UISupportedExternalAccessoryProtocols</key>
	<array>
		<string>com.meta.ar.wearable</string>
	</array>
	<!-- Archivo's static instances in TrainedEye/Fonts/ (SIL Open Font License). -->
	<key>UIAppFonts</key>
	<array>
		<string>Archivo-Display.ttf</string>
		<string>Archivo-Text.ttf</string>
		<string>Archivo-TextSemibold.ttf</string>
		<string>Archivo-Edge.ttf</string>
	</array>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Needed to connect to Meta AI Glasses</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Needed to connect to Meta AI Glasses</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Trained Eye connects to your glasses over Wi-Fi and sends camera frames to your Mac on the same network.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_bonjour._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Trained Eye watches through the iPhone camera when your glasses are not available.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Trained Eye records the request you speak when you teach it something new.</string>
	<!-- Plain http and ws to the Mac on the local network; a tunnel uses https and wss. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Saved clips show in the Files app, so they can be sent to the Mac. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
