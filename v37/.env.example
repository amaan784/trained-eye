# Copy this file to .env and fill in the values. .env is gitignored; never commit it.

# Meta Model API key (dev.meta.ai)
MODEL_API_KEY=

# Hugging Face token with write access (used only when publishing, after asking)
HF_TOKEN=

# Weights & Biases API key. For Modal jobs, also store it as a Modal Secret named "wandb".
WANDB_API_KEY=

# W&B team: not read from here. Pass it to Modal jobs instead, e.g.
#   modal run backend/training/wandb_smoke.py --entity <team>

# Optional overrides
# TE_DATA_DIR=data              # a folder inside the project, or an absolute path or ~/...
# TE_SKILL_CAP_USD=10
# TE_GLOBAL_CAP_USD=120
# TE_TRAIN_ON_MODEL_OUTPUTS=1   # 0 if training on Muse outputs is not allowed
# TE_MODEL_LABELER=muse-spark-1.3
