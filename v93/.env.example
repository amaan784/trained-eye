# Copy this file to .env and fill in the values. .env is gitignored; never commit it.

# Meta Model API key (dev.meta.ai)
MODEL_API_KEY=

# Hugging Face token with write access (used only when publishing, after asking)
HF_TOKEN=

# Weights & Biases API key. For Modal jobs, also store it as a Modal Secret named "wandb".
WANDB_API_KEY=

# Key for the trained model's Modal endpoint (te serve-student). Make up a long random
# value and store the same one as a Modal Secret named "student".
STUDENT_API_KEY=

# Token for teaching from the phone (te serve's /teach routes, which spend money). Make up
# a long random value and enter the same one in the app's Connect screen.
SERVER_TOKEN=

# W&B team: not read from here. Pass it to Modal jobs instead, e.g.
#   modal run backend/training/wandb_smoke.py --entity <team>

# Optional overrides
# TE_DATA_DIR=data              # a folder inside the project, or an absolute path or ~/...
# TE_SKILL_CAP_USD=10
# TE_GLOBAL_CAP_USD=120
# TE_TRAIN_ON_MODEL_OUTPUTS=1   # 0 if training on Muse outputs is not allowed
# TE_SYSTEM_IN_USER=0           # 1 folds the system prompt into the user text of new datasets
# TE_MODEL_LABELER=muse-spark-1.3
# TE_STUDENT_URL=https://<the URL te serve-student prints>/v1   # the trained model
# TE_STUDENT_MODEL=trained-eye
# TE_STUDENT_MAX_TOKENS=512     # the student's reply budget; base Glimmer may need more
